sw $t1, 2032($t0)

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ NextPixelsBox ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~#
NextPixelsBox:
lw $t0, displayAddress   
lw $v1, borderColour    

li $t2, 14           # x0 
li $t3, 2           # y0

li $t4, 32
mul $t5, $t3, $t4            #y0 * 32
add $t5, $t5, $t2            # y0 * 32 + x0

sll $t5, $t5, 2              # * 4
addu $t6, $t0, $t5       

li $t7, 0                    # row counter; 15 rows total

RowLoop_6x13:
beq $t7, 7, BorderDones     # if row == 5 = done


beq $t7, $zero, FullRows
li $t8, 6
beq $t7, $t8, FullRows

# middle rows: no middle
sw $v1, 0($t6)               # left border at x0
addiu $t9, $t6, 52           # right border at x0 + 7; offset 7 * 4 = 28 bytes
sw $v1, 0($t9)
j AfterRow

FullRows:
move $t9, $t6                # t9 = current pixel in row
li $t8, 0                    # column counter 0..7

FullRowLoops:
beq $t8, 14, AfterRow
sw $v1, 0($t9)
addiu $t9, $t9, 4             # next pixel (4 bytes)
addiu $t8, $t8, 1
j FullRowLoops

# next row
AfterRow:
addiu $t6, $t6, 128           # move down one row (32 * 4 bytes)
addiu $t7, $t7, 1             # row++
j RowLoop_6x13

BorderDones:
jr $ra

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ SaveScreen ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~#
SaveScreen:
lw $t0, displayAddress     
la $t1, screen_backup     
li $t2, 1024 

SaveScreen_loop:
lw $t3, 0($t0)              # read pixel from display
sw $t3, 0($t1)              # store into backup

addi $t0, $t0, 4              # next display word
addi $t1, $t1, 4              # next backup word
addi $t2, $t2, -1
bgtz $t2, SaveScreen_loop

jr $ra

#~~~~~~~~~~~~~~~~~~~~~~~~~~~ RestoreScreen ~~~~~~~~~~~~~~~~~~~~~~~~~~~~#
RestoreScreen:
la $t0, screen_backup       
lw $t1, displayAddress      
li $t2, 1024

RestoreScreen_loop:
lw $t3, 0($t0)              # read from backup
sw $t3, 0($t1)              # write to display

addi $t0, $t0, 4
addi $t1, $t1, 4
addi $t2, $t2, -1
bgtz $t2, RestoreScreen_loop

jal MainLoop

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ClearScreen ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~#
ClearScreen:
lw $t0, displayAddress
li $t1, 0x000000
li $t2, 1024
jal ClearScreenLoop

ClearScreenLoop:
sw $t1, 0($t0)
addi $t0, $t0, 4
addi $t2, $t2, -1
bgtz $t2, ClearScreenLoop

jal Main

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ FindMatches ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~#
ResolveAllMatches:
addiu $sp, $sp, -4
sw $ra, 0($sp)
li $s4, 0                # cascade_count = 0
sw $s4, cascade_count
li $s5, 0                # match cycle = 0    

ResolveLoop:
jal FindMatches
lw $t0, match_flag
beq $t0, $zero, Done_Resolve     # if no matches indicated in match_flag loop

move $t1, $s5           # t1 = firstWaveDone
beq $t1, $zero, FirstWave

lw $t2, cascade_count
addi $t2, $t2, 1 #adding 1 to the amount of match rounds
sw $t2, cascade_count
j AfterCascadeCheck

FirstWave:
li $s5, 1                  # firstWaveDone = true

AfterCascadeCheck:
# Continue looping until no more matches
j ResolveLoop

Done_Resolve:
lw $t3, cascade_count
li $t4, 1
blt $t3, $t4, NoCascadeBonus   # if cascade_count < 1 then no bonus

# Award +5 once
lw $t5, score
addi $t5, $t5, 5
sw $t5, score

NoCascadeBonus:
jal DrawScoreOnesDigit
jal DrawScoreTensDigit
jal DrawScoreHundredsDigit
lw $ra, 0($sp)
addiu $sp, $sp, 4
jr $ra

FindMatches:
addiu $sp, $sp, -4
sw $ra, 0($sp)
# run all match finders
li $t0, 0
sw $t0, removed_count

jal FindHorizontal
jal FindVertical
jal FindUpperDiagonal
jal FindLowerDiagonal

# delete any marked blocks
jal DeleteMarkedBlocks
jal ApplyGravity
    
ScoreUpdate:
# add how many gems removed to the score
lw $t1, removed_count
lw $t2, score
add $t2, $t2, $t1
sw $t2, score
jal DrawScoreOnesDigit
jal DrawScoreTensDigit
jal DrawScoreHundredsDigit
lw $ra, 0($sp)
addiu $sp, $sp, 4
jr $ra


#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Horizontal ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~#
FindHorizontal:
addiu $sp, $sp, -4
sw $ra, 0($sp)
la $t0, matching_grid
lw $t9, displayAddress
lw $t1, borderX0
addi $t1, $t1, 1
lw $t2, borderY0
addi $t2, $t2, 1
lw $t6, white          # white marker

li $t7, 24             # grid height
li $t8, 6              # grid width

RowLoop:
li $t4, 0              # column = 0

ColumnLoop:
bge $t4, 4, NextRow    # only check col 0 - 3

lw $t3, borderX0
addi $t3, $t3, 1
add  $t3, $t3, $t4  # x = borderX0 + 1 + col

move $t5, $t2 # y = borderY0 +1 + rowIndex

li  $t0, 32
mul $t0, $t5, $t0
add $t0, $t0, $t3
sll $t0, $t0, 2
add $t0, $t0, $t9 

# load 3 colours
lw $t1, 0($t0)         # colour 0
lw $t3, 4($t0)         # colour 1
lw $t5, 8($t0)         # colour 2

# check if they match
beq $t1, $zero, NextCol
bne $t1, $t3, NextCol
bne $t1, $t5, NextCol

# convert screen row to grid row: gridRow = t2 - (borderY0+1)
lw  $t5, borderY0
addi $t5, $t5, 1
sub  $t5, $t2, $t5      # grid row 0 - 23

# idx0 = (gridRow * 6 + col)
mul $t8, $t5, 6
add $t8, $t8, $t4
sll $t8, $t8, 2
la $t0, matching_grid
add $t0, $t0, $t8
sw $t6, 0($t0)

# idx1 = (gridRo * 6 + col+1)
addi $t1, $t4, 1
mul $t8, $t5, 6
add $t8, $t8, $t1
sll $t8, $t8, 2
la $t0, matching_grid
add $t0, $t0, $t8
sw $t6, 0($t0)

# idx2 = (gridRow * 6 + col+2)
addi $t1, $t4, 2
mul $t8, $t5, 6
add $t8, $t8, $t1
sll $t8, $t8, 2
la $t0, matching_grid
add $t0, $t0, $t8
sw $t6, 0($t0)

NextCol:
addi $t4, $t4, 1
j ColumnLoop

NextRow:
addi $t2, $t2, 1
blt $t2, 28, RowLoop    # scan rows(24 rows)
lw $ra, 0($sp)
addiu $sp, $sp, 4
jr $ra

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Vertical ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~#
FindVertical:
addiu $sp, $sp, -4
sw $ra, 0($sp)
lw $t9, displayAddress   
lw $t6, white            
li $t4, 0                # col = 0   

ColumnLoop_V:
bge $t4, 6, Done_Vertical # done all 6 columns

# start screen y = borderY0 + 1 
lw $t2, borderY0
addi $t2, $t2, 1           # screen y

RowLoop_V:
# convert screen y to gridRow: gridRow = y - (borderY0 + 1)
lw $t0, borderY0
addi $t0, $t0, 1
sub  $t5, $t2, $t0         # gridRow 
bge  $t5, 22, NextCol_V

# compute screen x = borderX0 + 1 + col
lw $t0, borderX0
addi $t0, $t0, 1
add $t0, $t0, $t4         # t0 = x

#colour0 at (x, y)
li $t1, 32
mul $t3, $t2, $t1         # y * 32
add $t3, $t3, $t0         # y * 32 + x
sll $t3, $t3, 2
add $t3, $t3, $t9        
lw $t1, 0($t3)           # t1 = colour0

# if black, no match
beq $t1, $zero, NextRow_V

#colour1 at (x, y + 1)
addi $t7, $t2, 1           # y+1
li $t8, 32
mul $t3, $t7, $t8         # (y+1) * 32
add $t3, $t3, $t0         # + x
sll $t3, $t3, 2
add $t3, $t3, $t9
lw $t3, 0($t3)           # t3 = colour1
bne $t1, $t3, NextRow_V

#colour2 at (x, y + 2)
addi $t7, $t2, 2           # y+2
li $t8, 32
mul $t3, $t7, $t8         # (y + 2) * 32
add $t3, $t3, $t0         # + x
sll $t3, $t3, 2
add $t3, $t3, $t9
lw $t7, 0($t3)           # t7 = colour2

bne $t1, $t7, NextRow_V

# idx0 = (gridRow * 6 + col)
mul $t8, $t5, 6
add $t8, $t8, $t4
sll $t8, $t8, 2
la $t3, matching_grid
add $t3, $t3, $t8
sw $t6, 0($t3)

# idx1 = ((gridRow + 1) * 6 + col)
addi $t1, $t5, 1
mul $t8, $t1, 6
add $t8, $t8, $t4
sll $t8, $t8, 2
la $t3, matching_grid
add $t3, $t3, $t8
sw $t6, 0($t3)

# idx2 = ((gridRow + 2) * 6 + col)
addi $t1, $t5, 2
mul $t8, $t1, 6
add $t8, $t8, $t4
sll $t8, $t8, 2
la $t3, matching_grid
add $t3, $t3, $t8
sw $t6, 0($t3)

NextRow_V:
addi $t2, $t2, 1           # y++
j RowLoop_V

NextCol_V:
addi $t4, $t4, 1           # col++
j ColumnLoop_V

Done_Vertical:
lw $ra, 0($sp)
addiu $sp, $sp, 4
jr $ra

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Diagonal~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~#
FindLowerDiagonal:
addiu $sp, $sp, -4
sw $ra, 0($sp)
lw $t9, displayAddress   
lw $t6, white             
li $t1, 0                  # row = 0 - 21

RowLoop_Diag:
bge $t1, 22, Done_Diag      # stop after row 21
li $t2, 0                  # col = 0 - 3

ColLoop_Diag:
bge $t2, 4, NextRow_Diag    # only cols 0 - 3

# y1 = borderY0 + 1 + row
lw    $t7, borderY0
addi  $t7, $t7, 1
add   $t7, $t7, $t1         

# x1 = borderX0 + 1 + col
lw    $t8, borderX0
addi  $t8, $t8, 1
add   $t8, $t8, $t2       

# index1 = (y1 * 32 + x1) * 4
li    $t4, 32
mul   $t4, $t7, $t4          # y1 * 32
add   $t4, $t4, $t8          # + x1
sll   $t4, $t4, 2
addu  $t0, $t4, $t9  

lw    $t3, 0($t0)            # t3 = colourA
beq   $t3, $zero, NextCol_Diag   # empty = no match

# p1 + 132
addiu $t4, $t0, 132          # p2
lw $t4, 0($t4)            # t4 = colour2
bne $t3, $t4, NextCol_Diag

#p1 + 264
addiu $t5, $t0, 264          # p3
lw $t5, 0($t5)            # t5 = colour3
bne $t3, $t5, NextCol_Diag

# Match = Mark them in matching_grid with white
# idx0 = (row * 6 + col)
mul $t7, $t1, 6
add $t7, $t7, $t2
sll $t7, $t7, 2
la $t8, matching_grid
add $t8, $t8, $t7
sw $t6, 0($t8)

# idx1 = ((row + 1) * 6 + (col + 1))
addi $t7, $t1, 1           # row + 1
mul $t7, $t7, 6
addi $t8, $t2, 1           # col + 1
add $t7, $t7, $t8
sll $t7, $t7, 2
la $t8, matching_grid
add $t8, $t8, $t7
sw$t6, 0($t8)

# idx2 = ((row + 2) * 6 + (col + 2))
addi $t7, $t1, 2           # row + 2
mul $t7, $t7, 6
addi $t8, $t2, 2           # col + 2
add $t7, $t7, $t8
sll $t7, $t7, 2
la $t8, matching_grid
add $t8, $t8, $t7
sw $t6, 0($t8)

NextCol_Diag:
addi $t2, $t2, 1           # col++
j ColLoop_Diag

NextRow_Diag:
addi $t1, $t1, 1           # row++
j RowLoop_Diag

Done_Diag:
lw $ra, 0($sp)
addiu $sp, $sp, 4
jr $ra
    
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Diagonal  ( / ) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~#
FindUpperDiagonal:
addiu $sp, $sp, -4
sw $ra, 0($sp)
lw $t9, displayAddress 
lw $t6, white   
li $t1, 2                  # row = 2 - 23

RowLoop_LDiag:
bgt $t1, 23, Done_LDiag
li $t2, 0                  # col = 0 - 3

ColLoop_LDiag:
bgt $t2, 3, NextRow_LDiag

# y1 = borderY0 + 1 + row
lw $t7, borderY0
addi $t7, $t7, 1
add $t7, $t7, $t1          # y1

# x1 = borderX0 + 1 + col
lw $t8, borderX0
addi $t8, $t8, 1
add $t8, $t8, $t2          # x1

#display + (y1 * 32 + x1)*4
li $t4, 32
mul $t4, $t7, $t4
add $t4, $t4, $t8
sll $t4, $t4, 2
addu $t0, $t4, $t9          # p1

lw $t3, 0($t0)            # colour1
beq $t3, $zero, NextCol_LDiag

addiu $t4, $t0, -124         # p2
lw $t4, 0($t4)            # colour2
bne $t3, $t4, NextCol_LDiag

addiu $t5, $t0, -248         # p3
lw $t5, 0($t5)            # colour3
bne $t3, $t5, NextCol_LDiag

#match
# idx0 = row * 6 + col
mul $t7, $t1, 6
add $t7, $t7, $t2
sll $t7, $t7, 2
la $t8, matching_grid
add $t8, $t8, $t7
sw $t6, 0($t8)

# idx1 = (row - 1) * 6 + (col + 1)
addi $t7, $t1, -1
mul $t7, $t7, 6
addi $t8, $t2, 1
add $t7, $t7, $t8
sll $t7, $t7, 2
la $t8, matching_grid
add $t8, $t8, $t7
sw $t6, 0($t8)

# idx2 = (row - 2) * 6 + (col + 2)
addi $t7, $t1, -2
mul $t7, $t7, 6
addi $t8, $t2, 2
add $t7, $t7, $t8
sll $t7, $t7, 2
la $t8, matching_grid
add $t8, $t8, $t7
sw $t6, 0($t8)

NextCol_LDiag:
addi $t2, $t2, 1
j ColLoop_LDiag

NextRow_LDiag:
addi $t1, $t1, 1
j  RowLoop_LDiag

Done_LDiag:
lw $ra, 0($sp)
addiu $sp, $sp, 4
jr $ra

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~ DeleteMarkedBlocks ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~#
DeleteMarkedBlocks:
la $t0, matching_grid     
lw $t9, displayAddress    
lw $t7, white            
li $t6, 0                 # black (erase)
li $t1, 0                 # row = 0
li $s2, 0
sw $s2, match_flag

RowLoop_Delete:
bge $t1, 24, Done_Delete   # 24 rows
li $t2, 0                 # col = 0

ColLoop_Delete:
bge $t2, 6, NextRow_Delete # 6 columns

mul $t3, $t1, 6
add $t3, $t3, $t2
sll $t3, $t3, 2            # bytes

# load match_grid[row][col]
la $t4, matching_grid
add $t4, $t4, $t3
lw $t5, 0($t4)
bne $t5, $t7, SkipCell

lw $t8, borderX0
addi $t8, $t8, 1
add $t8, $t8, $t2          # final x

# compute y = row + borderY0 + 1
lw $t4, borderY0
addi $t4, $t4, 1
add  $t4, $t4, $t1          # final y

# idx = y * 32 + x
li $t5, 32
mul $t5, $t4, $t5
add $t5, $t5, $t8
sll $t5, $t5, 2            # bytes
add $t5, $t9, $t5

sw $t6, 0($t5)
lw $s3, removed_count
addi $s3, $s3, 1
sw $s3, removed_count


la $t4, matching_grid      
addu $t4, $t4, $t3   # grid + offset
sw $zero, 0($t4)   # store 0 into that cell
#match_flag = 1
li $s2, 1
sw $s2, match_flag

SkipCell:
addi $t2, $t2, 1
j ColLoop_Delete

NextRow_Delete:
addi $t1, $t1, 1
j RowLoop_Delete

Done_Delete:
jr $ra

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ApplyGravity ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~#
ApplyGravity:
addiu $sp, $sp, -4
sw $ra, 0($sp)
lw $t9, displayAddress 

lw $t0, borderX0
addi $t0, $t0, 1              # X = left inner border

lw $t1, borderY0
addi $t1, $t1, 1              # Y = top inner border
li $t2, 0                   # col = 0

Gravity_ColLoop:
bge  $t2, 6, Gravity_DoneCols # only 6 columns (0 - 5)

# x = X + col
add $t3, $t0, $t2            # screen x for this column

li $t4, 23                  # writeRow = bottom grid row
li $t5, 23                  # scanRow = bottom grid row

Gravity_ScanLoop:
bltz $t5, Gravity_FillBlanks  # when scanRow < 0, start clearing above

# y = Y + scanRow  (screen y)
add  $t8, $t1, $t5

li $t7, 32
mul $t7, $t8, $t7            # y * 32
add $t7, $t7, $t3            # + x
sll $t7, $t7, 2              # *4 bytes
addu $t6, $t9, $t7            

lw   $t8, 0($t6)              # colour at (scanRow, col)
beq  $t8, $zero, Gravity_NextScan   # if empty, move scanRow up
beq  $t5, $t4, Gravity_SameRow

add  $t8, $t1, $t4
li   $t7, 32
mul  $t7, $t8, $t7            # yDest * 32
add  $t7, $t7, $t3            # + x
sll  $t7, $t7, 2
addu $t7, $t9, $t7            # t7 = destination

# Move colour down and clear old spot
lw $t8, 0($t6)              # reload colour
sw $t8, 0($t7)              
sw $zero, 0($t6)           

addi $t4, $t4, -1             # writeRow--
addi $t5, $t5, -1             # scanRow--
j Gravity_ScanLoop

Gravity_SameRow:
addi $t4, $t4, -1             # writeRow--
addi $t5, $t5, -1             # scanRow--
j    Gravity_ScanLoop

Gravity_NextScan:
addi $t5, $t5, -1
j Gravity_ScanLoop

Gravity_FillBlanks:
bltz $t4, Gravity_NextCol     # when writeRow < 0, this column is done

# y = Y + writeRow
add $t8, $t1, $t4
li $t7, 32
mul $t7, $t8, $t7
add $t7, $t7, $t3
sll $t7, $t7, 2
addu $t7, $t9, $t7            # destination

sw $zero, 0($t7)            # ensure cell is empty
addi $t4, $t4, -1
j Gravity_FillBlanks

Gravity_NextCol:
addi $t2, $t2, 1              # col++
j Gravity_ColLoop

Gravity_DoneCols:
lw $ra, 0($sp)
addiu $sp, $sp, 4
jr $ra

